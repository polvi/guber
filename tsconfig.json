{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "isolatedModules": true,
    "lib": ["ES2022", "WebWorker"],
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["@cloudflare/workers-types", "bun-types"],
    "baseUrl": ".",
    "paths": {
      "@guber/core": ["./packages/core/index.ts"],
      "@guber/api-client": ["./packages/api-client/index.ts"],
      "@guber/controllers": ["./packages/controllers/index.ts"]
    }
  },
  "include": ["packages/**/*"],
  "exclude": ["node_modules"]
}
